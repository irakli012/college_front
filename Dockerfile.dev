# Use the official Node.js image based on Alpine Linux (lightweight)
FROM node:22-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and package-lock.json first to cache the npm install step
COPY package*.json ./

# Install project dependencies
RUN npm install

# Copy the rest of the application files
COPY . .

# Expose the ports for Vite and the Express server
EXPOSE 3000 5000

# Start the application using your existing admin-dev script
CMD ["npm", "run", "admin-dev"]
